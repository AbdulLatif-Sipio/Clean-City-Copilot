# CleanCity Copilot Backend Configuration

# Server Settings
APP_NAME=CleanCity Copilot API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Authentication
# Secret key used for Admin Dashboard authentication header: X-Admin-API-Key
ADMIN_API_KEY=cleancity-admin-secret-key-2026

# Rate Limiting
# Format: "<number> per <second|minute|hour|day>"
SUBMIT_RATE_LIMIT=10/minute

# File Upload Settings
MAX_UPLOAD_SIZE_BYTES=10485760  # 10MB in bytes
UPLOAD_DIR=media
IMAGE_SUBDIR=media/images
AUDIO_SUBDIR=media/audio

# Geo-Deduplication Settings
GEO_DEDUP_RADIUS_METERS=50.0
GEO_DEDUP_TIME_WINDOW_HOURS=48.0

# CORS Origins (comma-separated list for Streamlit frontends)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000

# AI Pipeline Configuration (Syed Fazeel's AI module)
# Options: "mock" (offline / test mode), "gemini", "qoder", "whisper_vision"
AI_PROVIDER=mock
GEMINI_API_KEY=
WHISPER_MODEL_SIZE=base
VISION_MODEL_NAME=gemini-1.5-flash
